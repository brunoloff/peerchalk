#!/usr/bin/env python3
"""Serve the browser build of PeerChalk on loopback and open it.

Each port is a separate browser origin with its own saved data, so two ports give two
independent users in one browser. Unknown addresses get the app, as on GitHub Pages, so
board links work here too.
"""
from functools import partial
from http.server import SimpleHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
import argparse
import sys
import webbrowser


class SiteHandler(SimpleHTTPRequestHandler):
    def do_GET(self) -> None:
        target = Path(self.translate_path(self.path))
        if target.is_file() or (target.is_dir() and (target / "index.html").is_file()):
            super().do_GET()
            return
        body = (Path(self.directory) / "404.html").read_bytes()
        self.send_response(404)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--port", type=int, default=8931)
    parser.add_argument("--no-open", action="store_true", help="do not open a browser")
    options = parser.parse_args()
    site = Path(__file__).resolve().parent.parent / "build/web/site"
    if not (site / "index.html").is_file():
        print("PeerChalk for browsers is not built. Run deploy/web/build.sh.", file=sys.stderr)
        return 1
    handler = partial(SiteHandler, directory=str(site))
    with ThreadingHTTPServer(("127.0.0.1", options.port), handler) as server:
        url = f"http://127.0.0.1:{options.port}/"
        print(f"PeerChalk: {url}\nPress Ctrl+C to stop.", flush=True)
        if not options.no_open:
            webbrowser.open(url)
        try:
            server.serve_forever()
        except KeyboardInterrupt:
            print("\nStopped.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
