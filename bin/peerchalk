#!/bin/sh
# Runs the PeerChalk app from the native build directory.
set -eu
root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
app="$root/build/linux/src/peerchalk"
if [ ! -x "$app" ]; then
    printf 'PeerChalk is not built. Build it with: %s\n' \
        'cmake --workflow --preset linux' >&2
    exit 1
fi
exec "$app" "$@"
