# Writes the version this build shows (cmake -P). On the commit tagged v<VERSION> that is just
# VERSION; N commits further it is VERSION+N, so that every development build tells itself apart.
# The longer form for logs adds the commit and whether it had uncommitted changes. Without git
# (a source tarball) both are VERSION. The file is rewritten only when it changes, so that only
# what includes it is rebuilt.
#
#   -DVERSION=0.2.3 -DSOURCE_DIR=... -DOUTPUT=.../peerchalk_build.hpp
#   -DDESCRIBE="v0.2.3-7-gabc1234-dirty" stands in for git, for tests.
if(NOT DEFINED DESCRIBE)
    execute_process(
        COMMAND git -C "${SOURCE_DIR}" describe --tags --long --match "v[0-9]*" --dirty
        OUTPUT_VARIABLE DESCRIBE OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET RESULT_VARIABLE failed)
    if(failed)
        set(DESCRIBE "")
    endif()
endif()

set(build "${VERSION}")
set(detail "${VERSION}")
if(DESCRIBE MATCHES "^v([0-9.]+)-([0-9]+)-g([0-9a-f]+)(-dirty)?$")
    set(tagged "${CMAKE_MATCH_1}")
    set(commits "${CMAKE_MATCH_2}")
    set(commit "${CMAKE_MATCH_3}")
    set(dirty "${CMAKE_MATCH_4}")
    if(NOT (tagged STREQUAL VERSION AND commits EQUAL 0))
        set(build "${VERSION}+${commits}")
    endif()
    set(detail "${build} (commit ${commit}")
    if(dirty)
        string(APPEND detail ", with uncommitted changes")
    endif()
    string(APPEND detail ")")
endif()

set(text "#pragma once\n// Generated by cmake/BuildStamp.cmake.\n#define PEERCHALK_BUILD \"${build}\"\n#define PEERCHALK_BUILD_DETAIL \"${detail}\"\n")
if(EXISTS "${OUTPUT}")
    file(READ "${OUTPUT}" previous)
endif()
if(NOT previous STREQUAL text)
    file(WRITE "${OUTPUT}" "${text}")
endif()
